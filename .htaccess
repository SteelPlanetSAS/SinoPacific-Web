# Sino Pacific SAS — sinopacific.com.co
# Antes de este archivo NO existia ningun .htaccess en public_html.
# Para revertir por completo, basta con borrarlo.

# --- Canonical: todo el trafico a https://www.sinopacific.com.co/ ---
# Solo se evalua el host. Tras el salto el host YA es www, la condicion
# deja de cumplirse y no hay bucle. El salto a HTTPS ya lo hace Hostinger.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_HOST} !^www\. [NC]
  RewriteRule ^ https://www.sinopacific.com.co%{REQUEST_URI} [R=301,L]
</IfModule>

# --- Pagina 404 propia ---
ErrorDocument 404 /404.html

# --- Tipos MIME ---
<IfModule mod_mime.c>
  AddType image/webp                 .webp
  AddType image/svg+xml              .svg
  AddType application/manifest+json  .webmanifest
</IfModule>

# --- Compresion ---
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json application/xml
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# --- Cache: estaticos largo, HTML corto ---
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp        "access plus 1 year"
  ExpiresByType image/jpeg        "access plus 1 year"
  ExpiresByType image/png         "access plus 1 year"
  ExpiresByType text/css          "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/html         "access plus 10 minutes"
  ExpiresByType application/xml   "access plus 1 hour"
  ExpiresByType text/plain        "access plus 1 hour"
</IfModule>

# --- Cabeceras de seguridad ---
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
